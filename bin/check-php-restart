#!/bin/sh
set -eu

base_url=${1:?usage: bin/check-php-restart BASE_URL}
engine=${ENGINE:-docker}
project=${COMPOSE_PROJECT_NAME:-$(basename "$PWD")}
fail() { echo "check-php-restart: $*" >&2; exit 1; }
container() { $engine ps -q --filter "label=com.docker.compose.project=$project" --filter "label=com.docker.compose.service=$1" | head -n 1; }
addresses() { $engine inspect -f '{{range $name, $n := .NetworkSettings.Networks}}{{$name}} {{$n.IPAddress}} {{end}}' "$@"; }
free_address() {
    for host in $(seq 250 -1 200); do
        case " $2 " in *" $1.$host "*) continue ;; esac
        echo "$1.$host" && return
    done
}
status() { "$@" -s -o /dev/null -m 5 -w '%{http_code}' || true; }
wait_for_200() {
    tries=0
    until [ "$(status "$@")" = 200 ]; do tries=$((tries + 1)) && [ "$tries" -lt 30 ] || fail "no 200 from $* after php moved"; sleep 2; done
}

php=$(container php) nginx=$(container nginx)
set -- $(addresses "$php")
network=$1 old=$2 new=$(free_address "${2%.*}" "$(addresses $($engine ps -q))")
started=$($engine inspect -f '{{.State.StartedAt}}' "$nginx")

trap '$engine network connect --alias php "$network" "$php" 2> /dev/null || true' EXIT
$engine network disconnect "$network" "$php"
$engine network connect --ip "$new" --alias php "$network" "$php"
trap - EXIT
echo "check-php-restart: php moved from $old to $new"

wait_for_200 curl "$base_url/api/health"
wait_for_200 $engine exec "$nginx" curl http://127.0.0.1:9100/metrics
for request in 1 2 3 4 5 6 7 8; do [ "$(status curl "$base_url/api/health")" = 200 ] || fail "health request $request failed"; done
[ "$($engine inspect -f '{{.State.StartedAt}}' "$nginx")" = "$started" ] || fail "nginx was restarted"
echo "check-php-restart: nginx reaches php at $new without a restart"
