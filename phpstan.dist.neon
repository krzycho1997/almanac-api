parameters:
    level: 9
    paths:
        - .php-cs-fixer.dist.php
        - bin/console
        - config
        - public
        - src
        - tests
        - tools
    scanFiles:
        - config/reference.php
    excludePaths:
        - config/reference.php
        - tools/phpstan/tests/Architecture/Fixtures
        - tools/phpstan/tests/Rule/Fixtures
    tmpDir: var/phpstan
    phpat:
        show_rule_names: true
    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
        consoleApplicationLoader: tools/phpstan/console-application.php
    doctrine:
        objectManagerLoader: tools/phpstan/object-manager.php
        reportUnknownTypes: true

rules:
    - App\PHPStan\Rule\DataCarrierRule
    - App\PHPStan\Rule\DeclareStrictTypesRule

services:
    -
        class: App\PHPStan\Rule\ProviderLiteralRule
        arguments:
            sourceRoot: %currentWorkingDirectory%/src
            allowedHosts:
                - tools.ietf.org
                - www.rfc-editor.org
                - symfony.com
                - creativecommons.org
        tags:
            - phpstan.rules.rule
    -
        factory: PHPStan\Type\Doctrine\Descriptors\ReflectionDescriptor('App\Bookmark\Doctrine\BookmarkIdType')
        tags:
            - phpstan.doctrine.typeDescriptor
    -
        factory: PHPStan\Type\Doctrine\Descriptors\ReflectionDescriptor('App\Briefing\Contract\DiscoveryIdType')
        tags:
            - phpstan.doctrine.typeDescriptor
    -
        factory: PHPStan\Type\Doctrine\Descriptors\ReflectionDescriptor('App\Identity\Contract\UserIdType')
        tags:
            - phpstan.doctrine.typeDescriptor
    -
        factory: PHPStan\Type\Doctrine\Descriptors\ReflectionDescriptor('App\Identity\Doctrine\EmailType')
        tags:
            - phpstan.doctrine.typeDescriptor
    -
        class: App\PHPStan\Doctrine\JsonbTypeDescriptor
        tags:
            - phpstan.doctrine.typeDescriptor
    -
        class: App\Tests\Architecture\ModuleBoundaryTest
        tags:
            - phpat.test
    -
        class: App\Tests\Architecture\LayerTest
        tags:
            - phpat.test
