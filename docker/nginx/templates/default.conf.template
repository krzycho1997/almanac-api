map $http_x_request_id $almanac_request_id {
    "~^[A-Za-z0-9._-]{1,64}$" $http_x_request_id;
    default $request_id;
}

map $request_uri $almanac_path {
    "~^(?<path>[^?]*)" $path;
}

log_format almanac escape=json '{"time":"$time_iso8601","method":"$request_method","path":"$almanac_path",'
                               '"status":$status,"bytes":$body_bytes_sent,"duration":$request_time,'
                               '"request_id":"$almanac_request_id"}';

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
resolver_timeout 2s;

map $request_uri $almanac_cache_control {
    ~^/api/bookmarks no-store;
    default "";
}

server {
    listen 80;
    server_name _;
    root /srv/app/public;

    access_log /var/log/nginx/access.log almanac;
    server_tokens off;
    client_max_body_size 16k;

    gzip on;
    gzip_comp_level 5;
    gzip_types application/json application/problem+json;
    gzip_vary on;
    gzip_proxied any;

    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/request-id.conf;

    error_page 494 @bad_request;
    error_page 413 @too_large;
    error_page 502 503 504 =503 @unavailable;

    location @bad_request {
        include /etc/nginx/snippets/problem.conf;
        return 400 '{"type":"about:blank","title":"Bad Request","status":400,"detail":"The request could not be read."}';
    }

    location @too_large {
        include /etc/nginx/snippets/problem.conf;
        return 413 '{"type":"about:blank","title":"Content Too Large","status":413,"detail":"The request body may be at most 16 KB."}';
    }

    location @unavailable {
        include /etc/nginx/snippets/problem.conf;
        return 503 '{"type":"about:blank","title":"Service Unavailable","status":503,"detail":"The application is not answering; try again shortly."}';
    }

    location = /metrics {
        include /etc/nginx/snippets/problem.conf;
        return 404 '{"type":"about:blank","title":"Not Found","status":404,"detail":"Nothing exists at this address."}';
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location ~ ^/index\.php(/|$) {
        set $php_upstream php:9000;
        fastcgi_pass $php_upstream;
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTP_X_REQUEST_ID $almanac_request_id;
        fastcgi_hide_header X-Powered-By;
        fastcgi_hide_header X-Request-Id;
        internal;
    }

    location ~ \.php$ {
        return 404;
    }
}

server {
    listen 9100;
    server_name _;
    root /srv/app/public;

    access_log off;
    server_tokens off;

    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;

    location = /metrics {
        set $php_upstream php:9000;
        fastcgi_pass $php_upstream;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param ALMANAC_METRICS_SCRAPE 1;
        fastcgi_hide_header X-Powered-By;
    }

    location / {
        return 404;
    }
}
