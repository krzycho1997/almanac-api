{
    "name": "krzycho1997/almanac-api",
    "type": "project",
    "license": "proprietary",
    "description": "Daily briefing API aggregating NASA APOD, Wikipedia On This Day and Open-Meteo",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.8",
        "monolog/monolog": "^3.13",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.8",
        "friendsofphp/php-cs-fixer": "^3.95",
        "osteel/openapi-httpfoundation-testing": "^0.15",
        "phpat/phpat": "^0.12",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4.7",
        "symfony/browser-kit": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.12"
        },
        "process-timeout": 0
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/",
            "App\\PHPStan\\": "tools/phpstan/src/",
            "App\\PHPStan\\Tests\\": "tools/phpstan/tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "check:fast": [
            "@composer validate --strict",
            "bin/check-env-keys",
            "bin/console lint:yaml config --parse-tags",
            "@cs-check",
            "bin/console lint:container",
            "bin/console doctrine:schema:validate --skip-sync",
            "@phpstan",
            "@composer audit --locked",
            "@test:unit"
        ],
        "check": [
            "@check:fast",
            "@test"
        ],
        "cs-check": "php-cs-fixer check --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "test": [
            "@test:unit",
            "@test:db",
            "phpunit --testsuite integration,functional,e2e"
        ],
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration --do-not-fail-on-empty-test-suite",
        "test:functional": "phpunit --testsuite functional,e2e",
        "test:live": "phpunit --testsuite live --do-not-fail-on-empty-test-suite",
        "test:db": [
            "bin/console doctrine:database:drop --env=test --force --if-exists --no-interaction",
            "bin/console doctrine:database:create --env=test --no-interaction",
            "bin/console doctrine:migrations:migrate --env=test --no-interaction --allow-no-migration",
            "bin/console doctrine:schema:validate --env=test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*",
            "docker": false
        }
    }
}
