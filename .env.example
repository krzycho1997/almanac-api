APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
REDIS_URL=redis://redis:6379?timeout=1&read_timeout=1
LOG_LEVEL=info
DATABASE_URL="postgresql://almanac:almanac@database:5432/almanac?serverVersion=18&charset=utf8"
ALMANAC_DEFAULT_LAT=52.23
ALMANAC_DEFAULT_LON=21.01
ALMANAC_DEFAULT_LOCATION_NAME=Warsaw
APP_TIMEZONE=UTC
NASA_BASE_URI=https://api.nasa.gov
NASA_API_KEY=
ALMANAC_OTD_LIMIT=20
WIKIPEDIA_BASE_URI=https://en.wikipedia.org/api/rest_v1/
OPEN_METEO_BASE_URI=https://api.open-meteo.com
OPEN_METEO_ARCHIVE_BASE_URI=https://archive-api.open-meteo.com
ALMANAC_USER_AGENT="almanac-api/1.0 (+https://github.com/krzycho1997/almanac-api)"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
